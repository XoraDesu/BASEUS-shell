{
    "baseus": {
        "_comment": "BASEUS default configuration — baseus.json",
        "_version": "0.1.0",

        "shell": {
            "logLevel": "info"
        },

        "simulation": {
            "enabled": false,
            "_comment": "Offline simulation mode for UI design development without Hyprland (or set BASEUS_SIMULATION=1)"
        },

        "dock": {
            "triggerHeight": 2,
            "revealDuration": 200,
            "showLauncher": true,
            "pinnedApps": [
                {
                    "id": "terminal",
                    "title": "Terminal",
                    "appClass": "kitty",
                    "command": "kitty",
                    "icon": "utilities-terminal"
                },
                {
                    "id": "browser",
                    "title": "Browser",
                    "appClass": "firefox",
                    "command": "firefox",
                    "icon": "firefox"
                },
                {
                    "id": "editor",
                    "title": "Editor",
                    "appClass": "code",
                    "command": "code",
                    "icon": "text-editor"
                },
                {
                    "id": "files",
                    "title": "Files",
                    "appClass": "thunar",
                    "command": "thunar",
                    "icon": "system-file-manager"
                }
            ]
        },

        "topIsland": {
            "idleTimeout": 2000
        },

        "notifications": {
            "timeout": 3000,
            "position": "top-left"
        },

        "commandCenter": {
            "defaultPrefix": "",
            "actionPrefix": ">"
        },

        "workspaces": {
            "labels": {},
            "tags": {}
        },

        "performance": {
            "reducedMotion": false,
            "animationDuration": 250
        },

                "personality": {
            "bongoCat": {
                "enabled": true,
                "size": 32,
                "decayTimeout": 250
            },
            "constellation": {
                "enabled": true,
                "nodeCount": 8,
                "duration": 350
            },
            "contextualCue": {
                "timeout": 2200,
                "maxCharacters": 32
            }
        },

        "idle": {
            "dimTimeout": 300,
            "lockTimeout": 600,
            "suspendTimeout": 900,
            "autoLock": true,
            "autoSuspend": false,
            "inhibitByDefault": false
        }
    }
}
